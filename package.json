{
  "name": "doumiao-gamehouse",
  "version": "1.0.0",
  "private": true,
  "description": "抖喵游戏屋 — Go 后端 + React 前端",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "HOST=127.0.0.1 PORT=9988 go run ./cmd/server",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web && go build -o bin/server ./cmd/server",
    "build:web": "npm run build --prefix web",
    "build:server": "go build -o bin/server ./cmd/server",
    "test": "go test ./... && npm run build --prefix web",
    "start": "HOST=127.0.0.1 PORT=9988 ./bin/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
