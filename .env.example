# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录 .env
#
# Release 部署包或本机构建产物就绪后：
#   docker compose up -d

# 宿主机映射端口
HOST_PORT=9988

# 时区
TZ=Asia/Shanghai

# 后台管理口令（生产环境务必设置）
ADMIN_PASSWORD=

# 会话 HMAC 密钥（建议 32+ 随机字符；不填则使用 work/session.secret 文件）
# 可用：openssl rand -hex 32
SESSION_SECRET=

# Web Push VAPID 密钥。单实例通常留空并持久化 work/vapid.json；
# 多实例部署必须给所有实例配置同一对密钥，且两项必须同时设置。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Web Push VAPID 联系邮箱（直接填邮箱地址，不要带 mailto: 前缀；也可以填 https:// 开头的地址）
VAPID_SUBSCRIBER=admin@rps.rbq.io

# 会话有效期（毫秒），默认 24h
# SESSION_TTL_MS=86400000

# 额外允许的浏览器 Origin / 域名（反代到公网域名时建议填，逗号分隔）
# 例：https://rps.rbq.io,rps.rbq.io
# 不填时会用 X-Forwarded-Host / Host 与 Origin 主机名比对
ALLOWED_ORIGINS=

# 可信反向代理层数，默认 0（直连）；决定 X-Forwarded-For/X-Forwarded-Host 怎么解析。
# 部署在反向代理之后请显式设置为实际代理层数（通常为 1），否则限流/防多开会退化为按代理自身 IP 计算。
# TRUSTED_PROXY_COUNT=1

# 用户分析（默认开启；默认需要 config/xdb/ip2region_v4.xdb）
# ANALYTICS_ENABLED=1
# ANALYTICS_GEO_ENABLED=1
# GEOIP_DB_PATH=config/xdb/ip2region_v4.xdb
# IPv6 归属地库为可选加成，缺失不影响启动，只是 IPv6 来源的访客解析不到归属地
# GEOIP_DB_PATH_V6=config/xdb/ip2region_v6.xdb
# ANALYTICS_TZ_OFFSET_MIN=480
# ANALYTICS_RAW_RETENTION_DAYS=90

# 可选调优
# LOBBY_BROADCAST_DELAY_MS=300
# ROOM_BROADCAST_DELAY_MS=100
# MAX_SOCKETS_PER_IP=10
