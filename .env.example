# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录 .env
#
# 仓库已含 bin/server 与 dist/，一般可直接：
#   docker compose up -d

# 宿主机映射端口
HOST_PORT=9988

# 时区
TZ=Asia/Shanghai

# 后台管理口令（生产环境务必设置）
ADMIN_PASSWORD=

# 会话 HMAC 密钥（建议 32+ 随机字符；不填则使用 work/session.secret 文件）
# 可用：openssl rand -hex 32
SESSION_SECRET=

# 会话有效期（毫秒），默认 24h
# SESSION_TTL_MS=86400000

# 额外允许的浏览器 Origin（反代到别的域名时必填，逗号分隔）
# 例：https://game.example.com,https://www.example.com
ALLOWED_ORIGINS=

# 可选调优
# LOBBY_BROADCAST_DELAY_MS=300
# ROOM_BROADCAST_DELAY_MS=100
# MAX_SOCKETS_PER_IP=10
